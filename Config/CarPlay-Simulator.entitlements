<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only, so the CarPlay Simulator works before Apple approves the
	     entitlement. Once approved, add this key to the device build too. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
